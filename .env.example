# ============================================================
# PRONO SPORT — Variables d'environnement (exemple)
# Copier vers .env — ne JAMAIS committer de secrets (§69)
# ============================================================

# Environnement : development | staging | production (§70)
NODE_ENV=production

# Serveur
PORT=3000
HOST=0.0.0.0

# Base de données SQLite (chemin du fichier)
DB_PATH=./data/pronosport.db

# Saisons historiques football-data.co.uk à charger (codes du site)
# 2324 = 2023/24, 2425 = 2024/25, 2526 = 2025/26…
HISTORICAL_SEASONS=2324,2425,2526

# ---- Clés optionnelles (améliorent la couverture, jamais requises) ----

# football-data.org — tier gratuit officiel (12 compétitions, 10 req/min)
# S'inscrire sur https://www.football-data.org/client/register
FOOTBALL_DATA_ORG_KEY=

# TheSportsDB — la clé de test publique "123" est documentée par la source ;
# une clé Patreon augmente les limites et débloque des endpoints.
THESPORTSDB_KEY=123
